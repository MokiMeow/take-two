# Names only. Real values go in .env, which is never committed.
# scripts/judge_credentials.py and scripts/demo_day.py fill the local demo's values for you.

# Switch
SWITCH_API_URL=http://127.0.0.1:8000
SWITCH_REGISTRATION_KEY=            # personal key, so the coordinator is owned by you
SWITCH_PRODUCTION_ROOM_ID=          # the #production room (Mattermost)
SWITCH_CREW_ROOM_IDS=               # comma-separated crew rooms, e.g. #day-1 on Discord

# Who may decide what (Switch sender identities)
TAKE_TWO_DIRECTOR_ID=               # creative decisions: the only valid answer to a plan card
TAKE_TWO_PRODUCER_ID=               # location permission
TAKE_TWO_AD_ID=                     # availability, kit and overrun confirmation
TAKE_TWO_SAFETY_ID=
TAKE_TWO_CAPABILITY_AUTHORITY_ID=
TAKE_TWO_SCRIPT_SUPERVISOR_ID=
TAKE_TWO_CREW_IDENTITIES={}         # JSON: {"<switch sender id>": "maya", ...}

# The two reasoning agents (Switch Console names and sender ids)
TAKE_TWO_SUPERVISOR_AGENT_NAME=script-supervisor
TAKE_TWO_AD_AGENT_NAME=first-ad
TAKE_TWO_SUPERVISOR_SENDER_ID=
TAKE_TWO_AD_SENDER_ID=

# Shoot-day room on Discord
TAKE_TWO_DISCORD_BRIDGE=            # the bridge's display name in Switch, e.g. Discord crew

# Local paths and options
TAKE_TWO_TZ=Asia/Kolkata
TAKE_TWO_DB=data/ledger.sqlite
TAKE_TWO_ARTIFACTS=data/artifacts
TAKE_TWO_IDENTITY=data/identity.json
TAKE_TWO_RENDER_TIMEOUT=180
