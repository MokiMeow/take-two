# Names only. Real values go in .env, which is never committed.
SWITCH_API_URL=http://localhost:8000
SWITCH_REGISTRATION_KEY=        # personal key, so the coordinator is owned by you
SWITCH_AGENT_ID=
SWITCH_AGENT_KEY=
SWITCH_QUESTION_SESSION_ID=     # coordinator-generated UUID, reused across restarts
DISCORD_BOT_TOKEN=              # configures the Switch Discord bridge, not our code
TAKE_TWO_TZ=Asia/Kolkata
TAKE_TWO_DB=./data/ledger.sqlite
TAKE_TWO_ARTIFACTS=./out
